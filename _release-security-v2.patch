+const QUOTED_KEY_VALUE_SECRET_PATTERN = new RegExp(
+  '(\\b(?:' + SECRET_KEY_PATTERN + ')\\b\\s*(?:["\']\\s*)?[:=]\\s*)(["\'])([\\s\\S]*?)\\2',
+  'giu',
+)
+const UNQUOTED_KEY_VALUE_SECRET_PATTERN = new RegExp(
+  '(\\b(?:' + SECRET_KEY_PATTERN + ')\\b\\s*(?:["\']\\s*)?[:=]\\s*)(?!["\'])([^\\s,;}\\]]+)',
+  'giu',
