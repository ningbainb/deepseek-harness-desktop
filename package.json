{
  "name": "dsh-web-ui",
  "version": "3.0.0",
  "private": true,
  "description": "DeepSeek Harness Web GUI 皮肤集合 + 主题库预览页（仿 Codex-Dream-Skin / DreamSkin.cc）。每个皮肤是符合官方标准（turtle-ui 式 setup）的独立可安装插件包。",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --filter @deepseek-ai/dsh-desktop dev",
    "desktop:test": "pnpm --filter @deepseek-ai/dsh-desktop test",
    "desktop:pack": "pnpm --filter @deepseek-ai/dsh-desktop pack:win",
    "release:notes:check": "node scripts/validate-release-notes.mjs",
    "website:check": "node scripts/validate-website.mjs",
    "aggregate:check": "node scripts/aggregate.mjs --check",
    "gallery:check": "node scripts/gallery-build --check",
    "skin-center:check": "node scripts/skin-center-bundles --check",
    "community:check": "node scripts/community-index --check",
    "runtime-deps:check": "node scripts/runtime-deps-check.mjs",
    "dsh-imports:check": "node scripts/dsh-import-boundary.mjs --check",
    "dsh-audit:check": "node scripts/audit-dsh-coupling.mjs --check",
    "runtime-support:write": "node scripts/generate-runtime-support.mjs --write",
    "runtime-support:check": "node scripts/generate-runtime-support.mjs --check",
    "runtime-support-matrix:write": "node scripts/generate-runtime-support-matrix.mjs --write",
    "runtime-support-matrix:check": "node scripts/generate-runtime-support-matrix.mjs --check",
    "community-plugin-quality:write": "node scripts/generate-community-plugin-quality-report.mjs --write",
    "community-plugin-quality:check": "node scripts/generate-community-plugin-quality-report.mjs --check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm test:scripts && pnpm runtime-deps:check && pnpm dsh-imports:check && pnpm dsh-audit:check && pnpm runtime-support:check && pnpm runtime-support-matrix:check && pnpm community-plugin-quality:check && pnpm sync-shared:check && pnpm release:notes:check && pnpm website:check && pnpm aggregate:check && pnpm gallery:check && pnpm skin-center:check && pnpm community:check && pnpm docs:check",
    "skin:new": "node scripts/dsh-skin-new",
    "pr:review": "node scripts/pr-review.mjs",
    "gallery:build": "node scripts/gallery-build",
    "gallery:capture": "node scripts/capture-previews",
    "deploy:gallery": "node scripts/deploy-gallery",
    "docs:check": "node scripts/verify-docs.mjs",
    "docs:list": "node scripts/verify-docs.mjs --list",
    "docs:write-pair": "node scripts/verify-docs.mjs --write",
    "sync-shared": "node scripts/sync-shared.mjs",
    "sync-shared:check": "node scripts/sync-shared.mjs --check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.2"
  },
  "license": "Apache-2.0"
}
