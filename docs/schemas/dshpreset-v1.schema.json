{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ningbainb/deepseek-harness-desktop/blob/main/docs/schemas/dshpreset-v1.schema.json",
  "title": "DeepSeek Harness Desktop Preset v1 manifest",
  "$comment": "Preset v1 accepts additive optional fields for forward compatibility. formatVersion 1 remains the only supported major; callers should direct other majors to an upgrade path.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "formatVersion",
    "name",
    "createdAt",
    "source",
    "requiredCapabilities",
    "requiredSecrets"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["desktopVersion", "runtimeVersion"],
      "properties": {
        "desktopVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "runtimeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
    },
    "requiredSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }
    }
  }
}
