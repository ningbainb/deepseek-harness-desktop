+  handleExtension('extensions:profile-reset', () => enqueuePluginMutation(async () => {
+    await controller.stop()
+    const profileDir = join(dshHome, 'profiles', 'desktop')
+    const timestamp = Date.now()
+    const backupDir = `${profileDir}.backup-${timestamp}`
+    let moved = false
+    try {
+      try {
+        await rename(profileDir, backupDir)
+        moved = true
+      } catch (error) {
+        if (error?.code !== 'ENOENT') throw error
+      }
+      await ensureProfile()
+      await controller.start()
+    } catch (error) {
+      if (!moved) throw error
+      const rollbackErrors = []
+      try {
+        await rm(profileDir, { recursive: true, force: true })
+      } catch (rollbackError) {
+        rollbackErrors.push(rollbackError)
+      }
+      try {
+        await rename(backupDir, profileDir)
+      } catch (rollbackError) {
+        rollbackErrors.push(rollbackError)
+      }
+      if (rollbackErrors.length > 0) {
+        throw new Error('profile reset failed and rollback did not fully converge', {
+          cause: new AggregateError([error, ...rollbackErrors]),
+        })
+      }
+      throw error
+    }
+    void pruneProfileResetBackups(profileDir).catch(() => {})
+    return Object.freeze({ reset: true, timestamp })
+  }))
