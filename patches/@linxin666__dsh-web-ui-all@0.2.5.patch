diff --git a/lib/client.js b/lib/client.js
--- a/lib/client.js
+++ b/lib/client.js
@@ -53,17 +53,32 @@
 		* Register the shim for the page lifetime.
 		* @param ctx - client root context.
 		*/
 		function apply(ctx) {
+			const resetExpandedFooterActions = () => {
+				const sidebar = document.querySelector('[data-pane="sidebar"], [class*="sidebarCol"]');
+				if (!(sidebar instanceof HTMLElement) || sidebar.getBoundingClientRect().width <= 80) return;
+				for (const action of sidebar.querySelectorAll('[data-slot="sidebar.footer.action"]')) {
+					if (!(action instanceof HTMLElement)) continue;
+					if (action.style.getPropertyValue("margin-inline") === "auto") action.style.removeProperty("margin-inline");
+					if (action.style.getPropertyValue("justify-content") === "center") action.style.removeProperty("justify-content");
+				}
+			};
 			ctx.effect(() => {
 				applyShims();
+				resetExpandedFooterActions();
-				const observer = new MutationObserver(schedulePass);
+				const observer = new MutationObserver(() => {
+					resetExpandedFooterActions();
+					schedulePass();
+				});
 				observer.observe(document.body, {
 					childList: true,
-					subtree: true
+					subtree: true,
+					attributes: true,
+					attributeFilter: ["class", "style", "data-wide", "data-rail"]
 				});
 				return () => {
 					observer.disconnect();
 					shimScheduled = false;
 				};
 			});
 		}
