new file mode 100644
index 0000000..2d1e2f5
--- /dev/null
+++ b/src/client/desktop-layout.ts
@@ -0,0 +1,26 @@
+export function installLayoutCompatibilityAnchors(): () => void {
+  const ownedFrames = new Set<HTMLElement>();
+  const ownedCenters = new Set<HTMLElement>();
+  const sync = () => {
+    for (const rightbar of document.querySelectorAll("[data-rightbar-col], [data-sidebar-right-col]")) {
+      const frame = rightbar.parentElement;
+      const center = rightbar.previousElementSibling;
+      if (frame !== null && !frame.hasAttribute("data-dsh-frame")) {
+        frame.setAttribute("data-dsh-frame", "");
+        ownedFrames.add(frame);
+      }
+      if (center instanceof HTMLElement && !center.hasAttribute("data-pane")) {
+        center.setAttribute("data-pane", "conversation");
+        ownedCenters.add(center);
+      }
+    }
+  };
+  sync();
+  const observer = new MutationObserver(sync);
+  observer.observe(document.body, { childList: true, subtree: true });
+  return () => {
+    observer.disconnect();
+    for (const frame of ownedFrames) if (frame.getAttribute("data-dsh-frame") === "") frame.removeAttribute("data-dsh-frame");
+    for (const center of ownedCenters) if (center.getAttribute("data-pane") === "conversation") center.removeAttribute("data-pane");
+  };
+}
