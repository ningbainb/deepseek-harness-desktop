new file mode 100644
index 00000000..96baad0b
--- /dev/null
+++ b/src/client/companion-priority.ts
@@ -0,0 +1,22 @@
+/** Temporary renderer priority; never changes either companion's saved settings. */
+export function installCompanionPriority(target: Window, changed: () => void) {
+  let alive = true
+  let active = target.document.documentElement.getAttribute('data-desktop-dafeiyu-visible') === 'true'
+  const allowed = () => !active
+  const notify = (event: Event) => {
+    if (!alive) return
+    const detail: unknown = (event as CustomEvent).detail
+    active = typeof detail === 'boolean' ? detail
+      : target.document.documentElement.getAttribute('data-desktop-dafeiyu-visible') === 'true'
+    changed()
+  }
+  target.addEventListener('dsh-dafeiyu-visibility', notify)
+  return {
+    allowed,
+    dispose() {
+      if (!alive) return
+      alive = false
+      target.removeEventListener('dsh-dafeiyu-visibility', notify)
+    },
+  }
+}
