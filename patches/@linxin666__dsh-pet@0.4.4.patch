+export interface PetPosition { right: number; bottom: number }
+export interface PetSize { width: number; height: number }
+export interface ClearanceRect extends PetSize { left: number; top: number }
+export interface PetClearance extends PetPosition { safe: boolean; reason: 'clear' | 'moved' | 'no-space' }
+
+/** Project a raw preference; never persist a geometry-derived position. */
+export function projectPetPosition(raw: PetPosition, size: PetSize, viewport: PetSize, obstacles: readonly ClearanceRect[], gap = 8): PetClearance {
+  const origin = { left: viewport.width - raw.right - size.width, top: viewport.height - raw.bottom - size.height }
+  const maxLeft = viewport.width - size.width - gap
+  const maxTop = viewport.height - size.height - gap
+  const blocks = obstacles.filter(rect => rect.width > 0 && rect.height > 0
+    && [rect.left, rect.top, rect.width, rect.height].every(Number.isFinite))
+  const fits = (left: number, top: number) => left >= gap && top >= 40 && left <= maxLeft && top <= maxTop
+    && blocks.every(rect => left + size.width <= rect.left - gap || left >= rect.left + rect.width + gap
+      || top + size.height <= rect.top - gap || top >= rect.top + rect.height + gap)
+  const result = (left: number, top: number, safe: boolean): PetClearance => ({
+    right: viewport.width - left - size.width, bottom: viewport.height - top - size.height,
+    safe, reason: !safe ? 'no-space' : left === origin.left && top === origin.top ? 'clear' : 'moved',
+  })
+  if (fits(origin.left, origin.top)) return result(origin.left, origin.top, true)
+  const left = Math.max(gap, Math.min(maxLeft, origin.left))
+  const top = Math.max(40, Math.min(maxTop, origin.top))
+  const xs = new Set([left, gap, maxLeft])
+  const ys = new Set([top, 40, maxTop])
+  for (const block of blocks) {
+    xs.add(block.left - size.width - gap); xs.add(block.left + block.width + gap)
+    ys.add(block.top - size.height - gap); ys.add(block.top + block.height + gap)
+  }
+  let best: { left: number; top: number; distance: number } | undefined
+  for (const x of xs) for (const y of ys) {
+    if (!fits(x, y)) continue
+    const distance = (x - origin.left) ** 2 + (y - origin.top) ** 2
+    if (best === undefined || distance < best.distance) best = { left: x, top: y, distance }
+  }
+  return best === undefined ? result(left, top, false) : result(best.left, best.top, true)
+}
