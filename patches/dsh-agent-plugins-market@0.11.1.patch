diff --git a/lib/packages/market-catalog/src/scanning/source-replacement.js b/lib/packages/market-catalog/src/scanning/source-replacement.js
new file mode 100644
--- /dev/null
+++ b/lib/packages/market-catalog/src/scanning/source-replacement.js
@@ -0,0 +1,200 @@
+import { createHash, randomUUID } from 'node:crypto'
+import { lstat, mkdir, open, readFile, readdir, rename, rm } from 'node:fs/promises'
+import { basename, dirname, isAbsolute, join, relative, resolve, sep } from 'node:path'
+
+export function hashSourceState(source) {
+  const text = JSON.stringify(source ?? null, (_name, value) => value && typeof value === 'object' && !Array.isArray(value)
+    ? Object.fromEntries(Object.keys(value).sort().map(key => [key, value[key]])) : value)
+  return createHash('sha256').update(text).digest('hex')
+}
+
+function inside(root, path) {
+  const part = relative(root, path)
+  return part && !isAbsolute(part) && part !== '..' && !part.startsWith(`..${sep}`)
+}
+
+async function metadata(path) {
+  try { return await lstat(path) } catch (error) { if (error.code === 'ENOENT') return undefined; throw error }
+}
+
+async function directory(path, optional = false) {
+  const value = await metadata(path)
+  if (!value && optional) return false
+  if (!value?.isDirectory() || value.isSymbolicLink()) throw new Error('market source recovery requires real directories without links')
+  return true
+}
+
+export async function prepareSourceRoot(rootDirectory) {
+  const root = resolve(rootDirectory)
+  await mkdir(root, { recursive: true })
+  await directory(root)
+  return root
+}
+
+async function jsonFile(path) {
+  const value = await metadata(path)
+  if (!value?.isFile() || value.isSymbolicLink()) throw new Error('market recovery journal must be a regular file')
+  return JSON.parse(await readFile(path, 'utf8'))
+}
+
+async function persist(path, value) {
+  const temporary = `${path}.${randomUUID()}.tmp`
+  try {
+    const handle = await open(temporary, 'wx', 0o600)
+    try { await handle.writeFile(JSON.stringify(value)); await handle.sync() } finally { await handle.close() }
+    await rename(temporary, path)
+  } finally { await rm(temporary, { force: true }) }
+}
+
+function journalName(target) {
+  return `.desktop-source-replace-${createHash('sha256').update(target).digest('hex').slice(0, 16)}.json`
+}
+
+function safeTarget(value) {
+  return typeof value === 'string' && /^[a-zA-Z0-9.][a-zA-Z0-9._-]*$/u.test(value) && !value.includes('..')
+}
+
+async function locked(root, filename, operation) {
+  const path = join(root, `${filename}.lock`)
+  const nonce = randomUUID()
+  let handle
+  try { handle = await open(path, 'wx', 0o600) } catch (error) {
+    if (error.code !== 'EEXIST') throw error
+    const owner = await jsonFile(path)
+    if (!Number.isSafeInteger(owner.pid) || owner.pid <= 0 || typeof owner.nonce !== 'string') throw new Error(`invalid market recovery lock; retained at ${path}`)
+    try { process.kill(owner.pid, 0); throw new Error(`market source transaction is active in another host: ${path}`) } catch (alive) {
+      if (alive.code !== 'ESRCH') throw alive
+    }
+    await rm(path)
+    handle = await open(path, 'wx', 0o600)
+  }
+  try {
+    await handle.writeFile(JSON.stringify({ pid: process.pid, nonce }))
+    await handle.sync()
+    await handle.close()
+    handle = undefined
+    return await operation()
+  } finally {
+    await handle?.close()
+    const current = await jsonFile(path).catch(() => undefined)
+    if (current?.nonce === nonce) await rm(path)
+  }
+}
+
+function validateRecord(root, filename, record) {
+  if (record?.version !== 1 || !safeTarget(record.target) || filename !== journalName(record.target)
+    || !['prepared', 'swapped', 'committed', 'restoring', 'restored'].includes(record.phase)
+    || typeof record.hadOriginal !== 'boolean' || typeof record.backup !== 'string'
+    || !record.backup.startsWith(`.${record.target}.desktop-backup-`)
+    || !/^[a-f0-9-]{36}$/u.test(record.backup.slice(`.${record.target}.desktop-backup-`.length))
+    || basename(record.backup) !== record.backup || typeof record.staging !== 'string'
+    || !inside(root, resolve(root, record.staging))) throw new Error(`invalid market recovery journal retained at ${join(root, filename)}`)
+  if (record.commitState !== undefined) {
+    const commit = record.commitState
+    if (basename(root) !== '.sources' || commit.sourceId !== record.target
+      || !/^[a-f0-9]{64}$/u.test(commit.previous) || !/^[a-f0-9]{64}$/u.test(commit.next)) throw new Error('invalid market source state recovery record')
+  }
+}
+
+async function stateDecision(root, record) {
+  if (!record.commitState) return 'previous'
+  const state = await jsonFile(join(dirname(root), 'state.json'))
+  const source = state.sources?.find(source => source.id === record.commitState.sourceId)
+  const digest = hashSourceState(source)
+  if (digest === record.commitState.next) return 'next'
+  if (digest === record.commitState.previous) return 'previous'
+  throw new Error('market source state changed outside the pending transaction; recovery copies retained')
+}
+
+async function recoverOne(root, filename) {
+  const path = join(root, filename)
+  if (!await metadata(path)) return
+  const record = await jsonFile(path)
+  validateRecord(root, filename, record)
+  const destination = join(root, record.target)
+  const backup = join(root, record.backup)
+  const currentExists = await directory(destination, true)
+  const backupExists = await directory(backup, true)
+  const committed = record.phase === 'committed' || await stateDecision(root, record) === 'next'
+  if (committed) {
+    if (!currentExists) throw new Error(`committed market checkout is missing; recovery backup retained at ${backup}`)
+    if (backupExists) await rm(backup, { recursive: true })
+  } else if (backupExists && record.hadOriginal) {
+    if (currentExists) {
+      const quarantine = join(root, `.${record.target}.desktop-uncommitted-${randomUUID()}`)
+      await rename(destination, quarantine)
+    }
+    record.phase = 'restoring'
+    await persist(path, record)
+    await rename(backup, destination)
+    record.phase = 'restored'
+    await persist(path, record)
+  } else if (record.hadOriginal) {
+    if (!currentExists || !['prepared', 'restoring', 'restored'].includes(record.phase)) throw new Error(`previous market source cannot be located; journal retained at ${path}`)
+  } else if (currentExists) {
+    if (backupExists) throw new Error(`uncommitted market source has conflicting recovery copies; retained at ${path}`)
+    await rename(destination, backup)
+  }
+  await rm(path)
+}
+
+export async function recoverSourceReplacements(rootDirectory) {
+  const root = resolve(rootDirectory)
+  if (!await directory(root, true)) return
+  for (const entry of await readdir(root, { withFileTypes: true })) {
+    if (!/^\.desktop-source-replace-[a-f0-9]{16}\.json$/u.test(entry.name)) continue
+    if (!entry.isFile() || entry.isSymbolicLink()) throw new Error('market recovery refuses a linked journal')
+    await locked(root, entry.name, () => recoverOne(root, entry.name))
+  }
+}
+
+export async function replaceSourceDirectory(stagingDirectory, destinationDirectory, { root: rootDirectory = dirname(destinationDirectory), commit, commitState } = {}) {
+  const root = resolve(rootDirectory)
+  const staging = resolve(stagingDirectory)
+  const destination = resolve(destinationDirectory)
+  if (dirname(destination) !== root || !safeTarget(basename(destination)) || !inside(root, staging) || staging === destination) {
+    throw new Error('market source replacement escapes its managed root')
+  }
+  await mkdir(root, { recursive: true })
+  await directory(root)
+  const parts = relative(root, staging).split(sep)
+  let cursor = root
+  for (const part of parts) { cursor = join(cursor, part); await directory(cursor) }
+  await directory(destination, true)
+  const filename = journalName(basename(destination))
+  return locked(root, filename, async () => {
+    await recoverOne(root, filename)
+    const journal = join(root, filename)
+    const record = {
+      version: 1, target: basename(destination), staging: relative(root, staging),
+      backup: `.${basename(destination)}.desktop-backup-${randomUUID()}`,
+      hadOriginal: await directory(destination, true), phase: 'prepared', ...(commitState ? { commitState } : {}),
+    }
+    validateRecord(root, filename, record)
+    const backup = join(root, record.backup)
+    await persist(journal, record)
+    let committed = false
+    try {
+      if (record.hadOriginal) await rename(destination, backup)
+      await rename(staging, destination)
+      record.phase = 'swapped'
+      await persist(journal, record)
+      await commit?.()
+      committed = true
+      record.phase = 'committed'
+      await persist(journal, record)
+    } catch (error) {
+      if (committed) throw new Error(`market source committed but recovery journal needs attention: ${journal}`, { cause: error })
+      try { await recoverOne(root, filename) } catch (rollbackError) {
+        throw new Error(`market source recovery failed; complete backup retained at ${backup}`, { cause: new AggregateError([error, rollbackError]) })
+      }
+      throw error
+    }
+    try {
+      if (record.hadOriginal) await rm(backup, { recursive: true })
+      await rm(journal)
+    } catch (error) {
+      throw new Error(`market source committed; deferred recovery cleanup retained at ${journal}`, { cause: error })
+    }
+  })
+}
