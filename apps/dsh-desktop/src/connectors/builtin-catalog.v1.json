    {
      "id": "feishu",
      "name": {
        "zh": "飞书",
        "en": "Feishu / Lark"
      },
      "summary": {
        "zh": "读写飞书文档、多维表格、日历、任务、邮件与会话消息，附带官方 Agent Skills。",
        "en": "Read and write Feishu docs, Bitable, calendar, tasks, mail, and messages with official Agent Skills."
      },
      "category": "office-suite",
      "icon": "feishu",
      "color": "#3370ff",
      "maintainer": "official",
      "platforms": ["win32", "darwin", "linux"],
      "minDesktopVersion": "5.4.0",
      "officialUrls": {
        "repo": "https://github.com/larksuite/cli",
        "docs": "https://github.com/larksuite/cli#readme",
        "openPlatform": "https://open.feishu.cn/"
      },
      "drivers": [
        {
          "kind": "cli",
          "id": "feishu-cli",
          "binary": "lark-cli",
          "installSource": {
            "kind": "npm",
            "package": "@larksuite/cli"
          },
          "versionArgs": ["--version"],
          "skillsSource": {
            "kind": "repo-path",
            "repo": "larksuite/cli",
            "path": "skills"
          }
        },
        {
          "kind": "mcp-stdio",
          "id": "feishu-openapi-mcp",
          "command": "npx",
          "args": ["-y", "@larksuiteoapi/lark-mcp"],
          "installSource": {
            "kind": "npm",
            "package": "@larksuiteoapi/lark-mcp"
          },
          "toolLoading": "on-demand"
        }
      ],
      "auth": {
        "mode": "cli-native",
        "manualUrl": "https://open.feishu.cn/app",
        "cliLoginCommand": ["lark-cli", "auth", "login"],
        "requiresEnterpriseAdmin": false,
        "guideSteps": {
          "zh": [
            "点击安装飞书官方 CLI（lark-cli）并同步官方办公 Skills。",
            "如需操作自建企业应用权限，请在飞书开放平台创建应用并开通对应文档或消息权限。",
            "通过官方登录命令完成个人或企业账号授权，凭证将安全保存在系统钥匙串中。"
          ],
          "en": [
            "Install the official Feishu CLI (lark-cli) and register its bundled Agent Skills.",
            "For custom app scopes, create an app on the Feishu Open Platform and grant doc or message permissions.",
            "Complete the native login command so credentials stay inside your OS keychain."
          ]
        }
      },
      "healthCheck": {
        "kind": "cli-command",
        "args": ["--version"],
        "timeoutMs": 10000
      },
      "riskRules": [
        { "actionPattern": "docs.read|search|calendar.list", "level": "L0", "label": { "zh": "搜索与读取文档和日程", "en": "Search and read docs or calendar" } },
        { "actionPattern": "docs.create|task.create", "level": "L1", "label": { "zh": "新建草稿与个人待办", "en": "Create drafts or personal tasks" } },
        { "actionPattern": "calendar.update|docs.delete|base.batch", "level": "L2", "label": { "zh": "修改日程或批量更新表格", "en": "Modify calendar events or batch table writes" } },
        { "actionPattern": "im.send|mail.send|drive.share", "level": "L3", "label": { "zh": "发送飞书消息或对外分享文档", "en": "Send Feishu messages or share external links" } }
      ],
      "examples": [
        {
          "title": { "zh": "整理今日会议纪要", "en": "Summarize today's meeting notes" },
          "prompt": { "zh": "帮我查找今天飞书里的会议纪要文档，整理成待办清单发我确认。", "en": "Find today's meeting notes in Feishu and draft an action-item checklist for review." }
        },
        {
          "title": { "zh": "同步多维表格进展", "en": "Summarize Bitable project updates" },
          "prompt": { "zh": "读取飞书多维表格中本周到期的高优先级任务并汇总延期风险。", "en": "Read high-priority tasks due this week from Feishu Bitable and summarize risks." }
        }
      ],
      "troubleshooting": [
        {
          "code": "FEISHU_AUTH_REQUIRED",
          "matchPattern": "not logged in|unauthorized|login required",
          "cause": { "zh": "飞书登录态已过期或尚未完成授权。", "en": "Feishu CLI session has expired or is not signed in." },
          "fix": { "zh": "点击连接向导中的「重新授权」并按提示完成飞书扫码登录。", "en": "Click Re-authorize in the connector wizard and sign in to Feishu." }
        }
      ]
    },
    {
      "id": "tencent-docs",
      "name": {
        "zh": "腾讯文档",
        "en": "Tencent Docs"
      },
      "summary": {
        "zh": "通过官方远程 MCP 检索、阅读、编辑腾讯文档与智能表格，零本地程序安装。",
        "en": "Search, read, and edit Tencent Docs and Smart Sheets via official remote MCP with zero local install."
      },
      "category": "meeting-docs",
      "icon": "tencent-docs",
      "color": "#0052d9",
      "maintainer": "official",
      "platforms": ["win32", "darwin", "linux"],
      "minDesktopVersion": "5.4.0",
      "officialUrls": {
        "docs": "https://docs.qq.com/open/document/mcp/",
        "openPlatform": "https://docs.qq.com/open/auth/mcp.html"
      },
      "drivers": [
        {
          "kind": "mcp-remote",
          "id": "tencent-docs-mcp",
          "url": "https://mcp.docs.qq.com/mcp",
          "remoteTransport": "streamable-http",
          "toolLoading": "on-demand",
          "headersTemplate": {
            "Authorization": "Bearer ${credential:connector/tencent-docs/default/token}"
          },
          "allowedTools": [
            "smartcanvas.read",
            "smartcanvas.edit",
            "smartcanvas.find",
            "manage.create_file",
            "manage.export_file",
            "manage.search_file",
            "manage.folder_list",
            "manage.set_privilege"
          ]
        }
      ],
      "auth": {
        "mode": "personal-token",
        "quickAuthUrl": "https://docs.qq.com/open/auth/mcp.html",
        "manualUrl": "https://docs.qq.com/open/document/mcp/",
        "guideSteps": {
          "zh": [
            "点击打开腾讯文档官方 MCP 授权页并登录您的账号。",
            "生成并复制个人访问 Token（仅需复制一次）。",
            "将 Token 粘贴到下方输入框并点击验证连接，凭证将使用系统安全加密保存。"
          ],
          "en": [
            "Open the official Tencent Docs MCP authorization page and sign in.",
            "Generate and copy your personal access token.",
            "Paste the token below and verify the connection. Credentials are encrypted by your OS."
          ]
        },
        "fields": [
          {
            "key": "token",
            "label": { "zh": "MCP 访问令牌", "en": "MCP Access Token" },
            "fieldType": "password",
            "required": true,
            "secret": true
          }
        ]
      },
      "healthCheck": {
        "kind": "mcp-probe",
        "timeoutMs": 10000
      },
      "riskRules": [
        { "actionPattern": "read|find|search|folder_list", "level": "L0", "label": { "zh": "检索与读取云文档", "en": "Search and read documents" } },
        { "actionPattern": "create_file|edit", "level": "L1", "label": { "zh": "创建或写入文档内容", "en": "Create or edit documents" } },
        { "actionPattern": "set_privilege", "level": "L3", "label": { "zh": "变更文档外部权限与分享", "en": "Change document sharing privileges" } }
      ],
      "examples": [
        {
          "title": { "zh": "生成并保存工作周报", "en": "Save weekly status report" },
          "prompt": { "zh": "根据我提供的本周要点，在腾讯文档新建一份工作周报并整理好排版。", "en": "Create a formatted weekly status report in Tencent Docs from my key bullet points." }
        }
      ],
      "troubleshooting": [
        {
          "code": "TENCENT_DOCS_UNAUTHORIZED",
          "matchPattern": "401|invalid token|expired",
          "cause": { "zh": "腾讯文档 MCP Token 无效或已失效。", "en": "Tencent Docs MCP token is invalid or expired." },
          "fix": { "zh": "重新访问腾讯文档 MCP 授权页生成新 Token 并更新保存。", "en": "Generate a fresh token on the Tencent Docs MCP auth page and update it." }
        }
      ]
    },
