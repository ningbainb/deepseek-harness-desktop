{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "3.1.0",
  "private": true,
  "description": "Lossless desktop shell for DeepSeek Harness and the complete dsh-web-ui plugin collection",
  "author": "DeepSeek Harness Desktop contributors",
  "type": "module",
  "main": "src/main.mjs",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "electron src/main.mjs",
    "capture:startup": "node scripts/capture-startup.mjs",
    "capture:community": "node scripts/capture-startup.mjs --community",
    "capture:extensions": "node scripts/capture-startup.mjs --extensions",
    "capture:market": "node scripts/capture-market.mjs",
    "capture:update": "node scripts/capture-startup.mjs --update",
    "capture:star": "node scripts/capture-startup.mjs --star-prompt",
    "capture:star:burst": "node scripts/capture-startup.mjs --star-burst",
    "capture:qqbot": "node scripts/capture-startup.mjs --qqbot-qr",
    "measure:profile": "node scripts/measure-profile.mjs",
    "measure:packaged-startup": "node scripts/measure-packaged-startup.mjs",
    "test:window-chrome:e2e": "node scripts/verify-window-chrome.mjs",
    "test:settings-window:e2e": "node scripts/verify-settings-window.mjs",
    "test:terminal:e2e": "node scripts/verify-terminal.mjs",
    "test:particle-theme:e2e": "node scripts/verify-particle-theme.mjs",
    "test:conversation-skills:e2e": "node scripts/verify-conversation-skills.mjs",
    "test:directory-picker:e2e": "node scripts/verify-directory-picker.mjs",
    "test:profile-migration:e2e": "node scripts/verify-profile-migration.mjs",
    "test:migration-matrix:e2e": "node scripts/verify-packaged-migration-matrix.mjs",
    "test:preset-deep-link:e2e": "node scripts/verify-preset-deep-link.mjs",
    "test:runtime-provider:e2e": "node scripts/verify-runtime-provider.mjs",
    "test:task-board-worktree:e2e": "node scripts/verify-task-board-worktree.mjs",
    "test:update-shutdown:e2e": "node scripts/verify-update-shutdown.mjs",
    "test:star-prompt:e2e": "node scripts/verify-star-prompt.mjs",
    "test": "node --test test/*.test.mjs",
    "prepare:bundled-git": "node scripts/prepare-bundled-git.mjs",
    "pack:dir": "pnpm prepare:bundled-git && node src/release-manifest.mjs --assert-signing && electron-builder --dir",
    "pack:verify": "node scripts/verify-package.mjs",
    "pack:verify:dir": "node scripts/verify-package.mjs --allow-missing-update-metadata",
    "pack:smoke": "node scripts/verify-packaged-smoke.mjs",
    "test:profile-reset:e2e": "node scripts/verify-packaged-profile-reset.mjs",
    "pack:win": "pnpm prepare:bundled-git && node src/release-manifest.mjs --assert-signing && electron-builder --win nsis --publish never",
    "release:signing:check": "node src/release-manifest.mjs --assert-signing",
    "release:signatures:verify": "node src/release-manifest.mjs --verify-signatures --directory dist",
    "release:manifest:write": "node src/release-manifest.mjs --write --directory dist",
    "release:manifest:verify": "node src/release-manifest.mjs --verify --directory dist"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
