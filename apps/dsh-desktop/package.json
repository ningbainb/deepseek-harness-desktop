    "@linxin666/dsh-particle-theme": "workspace:*",
    "@linxin666/dsh-web-ui-all": "0.2.5",
    "@tencent-connect/dsh-qqbot": "0.4.0",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "koffi": "3.1.4",
    "node-pty": "1.2.0-beta.15",
    "pnpm": "11.22.0",
    "qrcode": "1.5.4",
    "reasoning-slider": "0.0.3",
    "schemastery": "3.18.0",
    "semver": "7.8.5",
    "ssh2": "1.17.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1",
    "sharp": "0.35.3"
  }
