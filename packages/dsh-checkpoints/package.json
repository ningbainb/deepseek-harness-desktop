{
  "name": "@ningbainb/dsh-checkpoints",
  "version": "0.1.0",
  "description": "Private Shadow Git checkpoint history and scoped workspace restoration for DeepSeek Harness Desktop.",
  "author": "ningbainb",
  "type": "module",
  "engines": { "node": "^22.19 || >=24" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --config-loader native",
    "typecheck": "tsc -b --force --pretty false && tsc -p tsconfig.vitest.json --pretty false",
    "test": "vitest run",
    "prepare": "tsdown --config-loader native"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "ignore": "7.0.17"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.3-alpha.2",
    "@ningbainb/dsh-user-scope": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.3-alpha.2",
    "@ningbainb/dsh-user-scope": "workspace:*",
    "@pierre/diffs": "1.5.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": ["lib/**/*.js", "lib/**/*.js.map", "lib/**/*.d.ts", "lib/**/*.d.ts.map", "src", "cordis.patch.yml", "README.md", "README.zh.md", "README.i18n.yaml", "NOTICE.md", "THIRD-PARTY-LICENSES.txt"],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningbainb/deepseek-harness-desktop.git",
    "directory": "packages/dsh-checkpoints"
  }
}
