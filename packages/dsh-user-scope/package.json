{
  "name": "@ningbainb/dsh-user-scope",
  "description": "Shared user identity, workspace/session ownership, and device-scoped authorization for DeepSeek Harness plugins",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.vitest.json --pretty false",
    "test": "vitest run",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1 || ^0.1.5-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.1 || ^0.1.5-alpha.1 || ^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.1 || ^0.1.5-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.1 || ^0.1.5-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web-ui.git",
    "directory": "packages/dsh-user-scope"
  }
}
