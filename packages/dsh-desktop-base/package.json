{
  "name": "dsh-desktop-base",
  "version": "0.1.0",
  "description": "Base aggregate for DeepSeek Harness Desktop features: Web UI collection, plugin market, Codex Connect, and reasoning controls.",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "DeepSeek Harness Desktop contributors",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "aggregate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ningbainb/deepseek-harness-desktop.git",
    "directory": "packages/dsh-desktop-base"
  },
  "homepage": "https://github.com/ningbainb/deepseek-harness-desktop#readme",
  "bugs": {
    "url": "https://github.com/ningbainb/deepseek-harness-desktop/issues"
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@linxin666/dsh-web-ui-all": "workspace:0.1.15",
    "dsh-codex-connect": "0.1.0-alpha.4.5",
    "dshmarket": "1.3.0",
    "reasoning-slider": "0.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
