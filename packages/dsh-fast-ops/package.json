{
  "name": "@ningbainb/dsh-fast-ops",
  "displayName": "nbfast",
  "description": "nbfast provides token-efficient workspace tools with AST-aware search and CAS edits, compact terminal output, and scoped result paging for DeepSeek Harness.",
  "author": "ningbainb",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --config-loader native",
    "typecheck": "tsc -b --force --pretty false",
    "test": "vitest run",
    "prepare": "tsdown --config-loader native"
  },
  "dependencies": {
    "ignore": "7.0.17"
  },
  "optionalDependencies": {
    "@ast-grep/lang-c": "0.0.6",
    "@ast-grep/lang-cpp": "0.0.6",
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-json": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.51.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@ningbainb/dsh-user-scope": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@ningbainb/dsh-user-scope": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "NOTICE.md"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningbainb/deepseek-harness-desktop.git",
    "directory": "packages/dsh-fast-ops"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
