{
  "name": "@ningbainb/dsh-local-search",
  "version": "0.1.0",
  "description": "Owner-isolated local hybrid search for memory, conversation history and workspace documents.",
  "author": "ningbainb",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --config-loader native",
    "typecheck": "tsc -b --force --pretty false",
    "test": "vitest run",
    "prepare": "tsdown --config-loader native"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningbainb/deepseek-harness-desktop.git",
    "directory": "packages/dsh-local-search"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2"
  },
  "optionalDependencies": {
    "sqlite-vec": "0.1.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.3-alpha.2",
    "@ningbainb/dsh-user-scope": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.3-alpha.2",
    "@ningbainb/dsh-user-scope": "workspace:*",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "NOTICE.md"
  ]
}
