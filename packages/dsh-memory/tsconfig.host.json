{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024"], "strict": true, "skipLibCheck": true, "isolatedModules": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "composite": true, "declaration": true, "declarationMap": true,
    "rootDir": "src", "outDir": "lib/types", "types": ["node"]
  },
  "include": ["src/index.ts", "src/core/**/*.ts", "src/routes.ts", "src/store.ts", "src/tools.ts"]
}
