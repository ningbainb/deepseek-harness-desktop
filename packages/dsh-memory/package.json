{
  "name": "@ningbainb/dsh-memory",
  "description": "Owner-isolated, local-only memory with explicit confirmation and bounded SystemPrompt injection.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.1",
    "@ningbainb/dsh-user-scope": "workspace:*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.1",
    "@ningbainb/dsh-user-scope": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "schemastery": "^3.18.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "AGENTS.md"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningbainb/deepseek-harness-desktop.git",
    "directory": "packages/dsh-memory"
  }
}
