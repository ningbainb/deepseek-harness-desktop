{
  "name": "@linxin666/dsh-desktop-compat",
  "description": "Desktop-only compatibility fixes for DeepSeek Harness queue continuation and cancellation presentation.",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./workspace-file-open-policy": {
      "types": "./lib/types/workspace-file-open-policy.d.ts",
      "default": "./lib/workspace-file-open-policy.js"
    },
    "./session-recovery": {
      "types": "./lib/types/session-recovery.d.ts",
      "default": "./lib/session-recovery.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1",
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web-ui.git"
  }
}
